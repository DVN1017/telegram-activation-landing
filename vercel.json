{
  "version": 2,
  "functions": {
    "server.js": {
      "includeFiles": "{index.html,style.css,config.js,main.js,supabase.js,success.html,admin.html,vendor/**}"
    },
    "api/index.js": {
      "includeFiles": "{index.html,style.css,config.js,main.js,supabase.js,success.html,admin.html,vendor/**}"
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "^/api/orders$",
      "dest": "/api/index.js"
    },
    {
      "src": "^/webhooks/chariow$",
      "dest": "/api/index.js"
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    }
  ]
}