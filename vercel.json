{
  "version": 2,
  "routes": [
    {
      "src": "/api/orders",
      "dest": "/api/index.js"
    },
    {
      "src": "/webhooks/chariow",
      "dest": "/api/index.js"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
